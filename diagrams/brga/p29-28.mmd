flowchart TD
  P0["المالك يعتمد السياسة: الاساس والفترة والعتبة والبونص وسقف 6 ملايين"] --> P1["نسخة قواعد مسودة"]
  P1 --> P2["معاينة dry-run على فترة سابقة"]
  P2 --> P3["تفعيل النسخة - صلاحية rules.manage + مراجعة ثانية"]
  A["حركة مؤهلة - تحصيل او فاتورة حسب القرار"] --> B["تحديد الفترة من تاريخ الحركة"]
  B --> C["حساب الاستحقاق التراكمي للفترة قبل وبعد الحركة"]
  C --> D["قيد فرق الاستحقاق PENDING مع النسخة والتفصيل - ذري و idempotent"]
  R["عكس دفعة او ارتداد شيك او مرتجع"] --> R1{"حالة القيد الاصلي"}
  R1 -- "PENDING او APPROVED" --> R2["REVERSED لكل القيود المرتبطة"]
  R1 -- PAID --> R3["قيد تسوية سالب مرتبط بالاصل"]
  D --> E["اقفال الفترة: مراجعة مدير المبيعات"]
  E --> F["اعتماد - المعتمد ليس المندوب"]
  F --> G{"قناة الصرف"}
  G -- "ضمن الراتب" --> H["قراءة الحوافز المعتمدة في احتساب المسير وربط القيود بالمسير"]
  G -- "نقدا" --> I["سند صرف من حساب مالي + قيد + paidBy"]
  R3 --> H
  H --> J["PAID عند صرف المسير"]
  I --> J
  J --> K["نشر احداث القرار الى سجل التدقيق المركزي"]
